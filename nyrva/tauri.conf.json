{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nyrva",
  "version": "1.0.0",
  "identifier": "dev.lsthemagic.nyrva",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "notch",
      "url": "notch.html",
      "width": 340,
      "height": 460,
      "transparent": true,
      "decorations": false,
      "alwaysOnTop": true,
      "skipTaskbar": true,
      "resizable": false,
      "shadow": false,
      "visible": false,
      "focus": false
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../LICENSE": "LICENSE",
      "../CREDITS.md": "CREDITS.md",
      "glyphs/NOTICE.md": "PROVIDER_GLYPH_NOTICES.md"
    }
  }
}
